// This is your Prisma schema file.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Models are added per feature phase:
// - User:         auth Phase 1A
// - Campaign:     campaigns Phase 3A
// - Scene, Token: play-area Phase 4A
// - Character:    characters Phase 6A

/// User accounts (pre-seeded for MVP)
model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  campaigns   CampaignPlayer[]
  ownedTokens Token[]          @relation("TokenOwner")
  fogRegions  FogRegion[]
  characters  Character[]      @relation("CharacterOwner")

  @@map("users")
}

/// Session store for express-session (connect-pg-simple)
model Session {
  sid    String   @id
  sess   Json
  expire DateTime

  @@index([expire])
  @@map("session")
}

// ---------------------------------------------------------------------------
// Campaign models (Phase 3A)
// ---------------------------------------------------------------------------

enum CampaignRole {
  dm
  player
  observer

  @@map("campaign_role")
}

enum GameSystem {
  dnd5e
  pf2e

  @@map("game_system")
}

/// A campaign — the top-level workspace for a TTRPG session
model Campaign {
  id          String     @id @default(uuid())
  name        String
  description String?
  gameSystem  GameSystem @default(dnd5e) @map("game_system")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  members    CampaignPlayer[]
  scenes     Scene[]
  tokens     Token[]
  messages   CampaignMessage[]
  fogRegions FogRegion[]
  fogExploration FogExploration[]
  characters Character[]
  tileAssets TileAsset[]
  tilePlacements TilePlacement[]
  wallSegments WallSegment[]
  lightSources LightSource[]
  characterTokens CharacterToken[]

  @@map("campaigns")
}

/// Join table linking users to campaigns with a role
model CampaignPlayer {
  id         String       @id @default(uuid())
  campaignId String       @map("campaign_id")
  userId     String       @map("user_id")
  role       CampaignRole
  color      String?
  joinedAt   DateTime     @default(now()) @map("joined_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([userId])
  @@map("campaign_players")
}

// ---------------------------------------------------------------------------
// Play Area models (Phase 4B)
// ---------------------------------------------------------------------------

enum TokenType {
  player
  monster
  npc
  misc

  @@map("token_type")
}

/// NPC subtype — distinguishes friendly (ally) from hostile (enemy) NPCs (Phase 4F.2)
enum NpcSubtype {
  ally
  enemy

  @@map("npc_subtype")
}

/// A scene (map) within a campaign that hosts tokens
model Scene {
  id         String   @id @default(uuid())
  campaignId String   @map("campaign_id")
  name       String
  imageUrl   String?  @map("image_url")
  width      Int      @default(2048)
  height     Int      @default(2048)
  cellSize   Int      @default(64) @map("cell_size")
  isActive   Boolean  @default(false) @map("is_active")
  /// PM2 fog mask configuration; null falls back to DEFAULT_FOG_MASK_CONFIG.
  fogConfig  Json?    @map("fog_config")
  /// Editor 5G default atmosphere; rendered by play-area PM5.
  weatherPreset WeatherPreset @default(none) @map("weather_preset")
  /// Editor 5H scene library ordering — position within the campaign's scene strip.
  sortOrder  Int      @default(0) @map("sort_order")
  /// Editor 5H client-generated thumbnail, re-encoded server-side to WebP.
  thumbnailUrl String? @map("thumbnail_url")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tokens   Token[]
  fogRegions FogRegion[]
  fogExploration FogExploration[]
  tilePlacements TilePlacement[]
  wallSegments WallSegment[]
  lightSources LightSource[]

  @@index([campaignId])
  @@map("scenes")
}

/// An interactive token placed on a scene
model Token {
  id         String    @id @default(uuid())
  sceneId    String    @map("scene_id")
  campaignId String    @map("campaign_id")
  ownerId    String?   @map("owner_id")
  name       String
  type       TokenType
  x          Int       @default(0)
  y          Int       @default(0)
  size       Int       @default(1)
  color      String    @default("#4a9eff")
  iconUrl    String?   @map("icon_url")
  hp           Int?
  maxHp        Int?      @map("max_hp")
  ac           Int?
  visionRadius Int       @default(6) @map("vision_radius")
  auraRadius   Int?      @map("aura_radius")
  auraColor    String?   @map("aura_color")
  auraVisible  Boolean   @default(false) @map("aura_visible")
  auraType     String?   @map("aura_type")
  auraCondition String?  @map("aura_condition")
  /// Only set when type = 'npc'; null for all other token types (Phase 4F.2)
  npcSubtype   NpcSubtype? @map("npc_subtype")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  scene    Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  owner    User?    @relation("TokenOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  characterLink CharacterToken?

  @@index([sceneId])
  @@index([campaignId])
  @@map("tokens")
}

// ---------------------------------------------------------------------------
// Chat models (Phase 4D)
// ---------------------------------------------------------------------------

enum MessageType {
  chat
  roll
  system

  @@map("message_type")
}

/// A persisted chat message within a campaign
model CampaignMessage {
  id         String      @id @default(uuid())
  campaignId String      @map("campaign_id")
  userId     String      @map("user_id")
  username   String
  text       String
  type       MessageType @default(chat)
  rollData   Json?       @map("roll_data")
  createdAt  DateTime    @default(now()) @map("created_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@map("campaign_messages")
}

// ---------------------------------------------------------------------------
// Fog of war models (Phase 4F)
// ---------------------------------------------------------------------------

/// A revealed fog polygon on a scene.
model FogRegion {
  id              String   @id @default(uuid())
  campaignId      String   @map("campaign_id")
  sceneId         String   @map("scene_id")
  createdByUserId String   @map("created_by_user_id")
  vertices        Json
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  scene    Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([campaignId, sceneId])
  @@map("fog_regions")
}

/// A persisted explored area on a scene (Phase PM2).
/// Deduplicated per scene by a quantized grid cell key so movement does not
/// grow the table without bound.
model FogExploration {
  id         String   @id @default(uuid())
  campaignId String   @map("campaign_id")
  sceneId    String   @map("scene_id")
  cellKey    String   @map("cell_key")
  x          Float
  y          Float
  radius     Float
  createdAt  DateTime @default(now()) @map("created_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  scene    Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@unique([sceneId, cellKey])
  @@index([campaignId, sceneId])
  @@map("fog_exploration")
}

// ---------------------------------------------------------------------------
// Character models (Phase 6A)
// ---------------------------------------------------------------------------

/// A character sheet belonging to a user within a campaign.
/// campaignId null = global template (pregen) visible in every campaign;
/// templates are cloned into a campaign when linked or assigned (Phase 6B).
model Character {
  id              String   @id @default(uuid())
  campaignId      String?  @map("campaign_id")
  userId          String   @map("user_id")
  name            String
  race            String
  class           String
  level           Int      @default(1)
  abilityScores   Json     @map("ability_scores")
  hp              Int
  maxHp           Int      @map("max_hp")
  ac              Int      @default(10)
  proficiencyBonus Int     @default(2) @map("proficiency_bonus")
  speed           Int      @default(30)
  /// Skill proficiency names for interactive rolling (Phase 6C)
  skillProficiencies Json  @default("[]") @map("skill_proficiencies")
  /// Weapon/attack entries for interactive rolling (Phase 6C)
  attacks         Json     @default("[]")
  /// Spell entries with prepared state (Phase 6D)
  spells          Json     @default("[]")
  /// Spell slot max/used per level 1-9 (Phase 6D)
  spellSlots      Json     @default("[]") @map("spell_slots")
  portraitUrl     String?  @map("portrait_url")
  biography       String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation("CharacterOwner", fields: [userId], references: [id], onDelete: Cascade)
  tokenLink CharacterToken?

  @@index([campaignId])
  @@index([userId])
  @@map("characters")
}

/// Links a character sheet to a canvas token (Phase 6B).
/// One-to-one on both sides: a character drives at most one token and vice versa.
model CharacterToken {
  id          String   @id @default(uuid())
  campaignId  String   @map("campaign_id")
  characterId String   @unique @map("character_id")
  tokenId     String   @unique @map("token_id")
  createdAt   DateTime @default(now()) @map("created_at")

  campaign  Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  token     Token     @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("character_tokens")
}

// ---------------------------------------------------------------------------
// Editor models (Phase 5A)
// ---------------------------------------------------------------------------

enum AssetCategory {
  background
  playground
  foreground

  @@map("asset_category")
}

enum AssetSource {
  uploaded
  builtin

  @@map("asset_source")
}

/// A tile asset uploaded to a campaign's asset library
model TileAsset {
  id           String        @id @default(uuid())
  campaignId   String?       @map("campaign_id")
  filename     String
  url          String
  thumbnailUrl String        @map("thumbnail_url")
  width        Int
  height       Int
  category     AssetCategory @default(background)
  source       AssetSource   @default(uploaded)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  placements TilePlacement[]

  @@index([campaignId])
  @@map("tile_assets")
}

// ---------------------------------------------------------------------------
// Editor models (Phase 5B)
// ---------------------------------------------------------------------------

/// A tile asset placed on a scene at a specific position and transform
model TilePlacement {
  id         String        @id @default(uuid())
  sceneId    String        @map("scene_id")
  assetId    String        @map("asset_id")
  campaignId String        @map("campaign_id")
  x          Float         @default(0)
  y          Float         @default(0)
  width      Float
  height     Float
  rotation   Float         @default(0)
  zIndex     Int           @default(0) @map("z_index")
  category   AssetCategory
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  scene    Scene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  asset    TileAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  campaign Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([sceneId])
  @@index([campaignId])
  @@map("tile_placements")
}

// ---------------------------------------------------------------------------
// Editor models (Phase 5F)
// ---------------------------------------------------------------------------

/// A wall segment on a scene — raycasting input for play-area PM3 line of sight
model WallSegment {
  id             String   @id @default(uuid())
  sceneId        String   @map("scene_id")
  campaignId     String   @map("campaign_id")
  x1             Float
  y1             Float
  x2             Float
  y2             Float
  blocksLight    Boolean  @default(true) @map("blocks_light")
  blocksMovement Boolean  @default(true) @map("blocks_movement")
  isDoor         Boolean  @default(false) @map("is_door")
  isOpen         Boolean  @default(false) @map("is_open")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  scene    Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, sceneId])
  @@map("wall_segments")
}

// ---------------------------------------------------------------------------
// Editor models (Phase 5G)
// ---------------------------------------------------------------------------

enum LightEmitterType {
  torch
  fireplace
  lantern
  beacon
  custom

  @@map("light_emitter_type")
}

enum LightAnimationMode {
  none
  flicker
  pulse

  @@map("light_animation_mode")
}

enum WeatherPreset {
  none
  rain
  snow
  haze

  @@map("weather_preset")
}

/// An authored light emitter on a scene — rendered by play-area PM4
model LightSource {
  id            String             @id @default(uuid())
  sceneId       String             @map("scene_id")
  campaignId    String             @map("campaign_id")
  x             Float
  y             Float
  /// Radius in grid cells
  radius        Float
  color         String
  intensity     Float
  falloff       Float
  emitterType   LightEmitterType   @map("emitter_type")
  animationMode LightAnimationMode @default(none) @map("animation_mode")
  animationSeed Int                @map("animation_seed")
  /// Players see this light's glow and lit area even without line of sight
  alwaysVisible Boolean            @default(false) @map("always_visible")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  scene    Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, sceneId])
  @@map("light_sources")
}
